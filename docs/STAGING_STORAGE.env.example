# Copy to an ignored private .env file outside tracked source; never commit filled values.
# Use a separate Firebase project and private Drive folder, not production billing-pro-e6241.
BILLING_STORAGE_STAGING_PROJECT=
BILLING_STORAGE_AUTHORITY=firestore
FIREBASE_SERVICE_ACCOUNT=
BILLING_STORAGE_STAGING_FOLDER=
BILLING_DRIVE_FOLDER_ID=
BILLING_DRIVE_MODULES=bill,reconciliation,master,mapping,daily
BILLING_DRIVE_TRANSPORT=1
# My Drive: supply all three OAuth values server-side.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Alternative: service-account JSON or private file path, using a Shared Drive.
GOOGLE_DRIVE_SERVICE_ACCOUNT=
# Validate offline: npm run storage:preflight -- --env-file=<private-file>
# Does not migrate data, enable production flags, or deploy anything.
