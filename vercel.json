{
  "regions": ["bom1"],
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "mobile.html",
      "use": "@vercel/static"
    },
    {
      "src": "storage.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "daily-progress.html",
      "use": "@vercel/static"
    },
    {
      "src": "daily-entry.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/core/**",
      "use": "@vercel/static"
    },
    {
      "src": "Reconciliation master/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/Reconciliation[ %]20master/(data\\.json|data\\.js|upload\\.php)",
      "status": 403
    },
    {
      "src": "^/Reconciliation master/(data\\.json|data\\.js|upload\\.php)",
      "status": 403
    },
    {
      "src": "/js/data/(.*)",
      "dest": "https://billing.130.210.67.101.sslip.io/js/data/$1"
    },
    {
      "src": "/daily-progress(\\.html)?",
      "dest": "/daily-progress.html",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/daily-entry(\\.html)?",
      "dest": "/daily-entry.html",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/(index\\.html)?",
      "dest": "https://billing.130.210.67.101.sslip.io/$1"
    },
    {
      "src": "/(mobile(?:\\.html)?|old(?:/index\\.html)?)",
      "dest": "https://billing.130.210.67.101.sslip.io/$1"
    },
    {
      "src": "/Reconciliation(?: |%20)master/index\\.html",
      "dest": "https://billing.130.210.67.101.sslip.io/Reconciliation%20master/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://billing.130.210.67.101.sslip.io/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "https://billing.130.210.67.101.sslip.io/$1"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/Reconciliation master/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
