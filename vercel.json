{
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "js/data/**",
          "index.html",
          "mobile.html",
          "portal-login.html",
          "public/daily-progress-template.xlsx",
          "Reconciliation master/index.html"
        ]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "mobile.html",
      "use": "@vercel/static"
    },
    {
      "src": "daily-progress.html",
      "use": "@vercel/static"
    },
    {
      "src": "daily-entry.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "js/core/**",
      "use": "@vercel/static"
    },
    {
      "src": "Reconciliation master/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/Reconciliation[ %]20master/(data\\.json|data\\.js|upload\\.php)",
      "status": 403
    },
    {
      "src": "^/Reconciliation master/(data\\.json|data\\.js|upload\\.php)",
      "status": 403
    },
    {
      "src": "/js/data/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/daily-progress(\\.html)?",
      "dest": "/daily-progress.html"
    },
    {
      "src": "/daily-entry(\\.html)?",
      "dest": "/daily-entry.html"
    },
    {
      "src": "/(index\\.html)?",
      "dest": "api/index.js"
    },
    {
      "src": "/(mobile(\\.html)?|old(/index\\.html)?)",
      "dest": "api/index.js"
    },
    {
      "src": "/Reconciliation(?: |%20)master/index\\.html",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/Reconciliation master/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
