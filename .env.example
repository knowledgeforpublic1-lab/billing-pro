# ==========================================
# ☁️ FIREBASE FIRESTORE CLOUD CONFIGURATION (PRIMARY)
# ==========================================
# Tarika 1 (Recommended for Vercel):
# Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
# Jo JSON download ho, usko single line JSON string bana kar yahan ya Vercel Environment Variables me paste karein:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}

# Tarika 2 (Individual variables agar single string na use karni ho):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tarika 3 (Local Development):
# Downloaded JSON ko rename karke "serviceAccountKey.json" project root me rakh dein (.gitignore me safe hai).

# ==========================================
# 🍃 MONGODB FALLBACK & MIGRATION (OPTIONAL)
# ==========================================
# Agar pehle se MongoDB me data hai aur Firebase me migrate karna hai:
# Run: node scripts/migrate_mongo_to_firebase.js
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/billingPro?retryWrites=true&w=majority

PORT=3000

# Optional API Security Key
# API_KEY set karne par /api/billing par x-api-key header required hoga.
API_KEY=
