# Copy karke .env banao aur values bhro. .env ko kabhi git me mat dalo.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/billingPro?retryWrites=true&w=majority
PORT=3000
# API_KEY set karne par /api/billing par x-api-key header required hoga (POST+GET).
# Khali chhoda to auth check skip (sirf local dev ke liye).
# Strong random value banao, Vercel env me bhi same value dalo.
# Browser me ek baar: localStorage.setItem('billing_api_key','<same-value>')
API_KEY=
