# ==========================================
# ☁️ FIREBASE FIRESTORE CLOUD CONFIGURATION (PRIMARY)
# ==========================================
# Tarika 1 (Recommended for Vercel):
# Firebase Console -> Project Settings -> Service accounts -> "Generate new private key"
# Jo JSON download ho, usko single line JSON string bana kar yahan ya Vercel Environment Variables me paste karein:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}

# Tarika 2 (Individual variables agar single string na use karni ho):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Tarika 3 (Local Development):
# Downloaded JSON ko rename karke "serviceAccountKey.json" project root me rakh dein (.gitignore me safe hai).

# ==========================================
# 🍃 MONGODB FALLBACK & MIGRATION (OPTIONAL)
# ==========================================
# Agar pehle se MongoDB me data hai aur Firebase me migrate karna hai:
# Run: node scripts/migrate_mongo_to_firebase.js
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/billingPro?retryWrites=true&w=majority

PORT=3000

# Optional API Security Key
# API_KEY set karne par /api/billing par x-api-key header required hoga.
API_KEY=

# Optional dedicated server session-encryption secret (recommended).
# If absent, the existing private database credential is used for encryption.
# Rotating either secret invalidates existing sessions, requiring a fresh login.
AUTH_SESSION_SECRET=
# Recovery owner is configured privately in the database (portalAuthOwnerV1).
# This optional environment setting overrides that registered address.
AUTH_REGISTERED_EMAIL=

# Inactivity session timeout in minutes (default 240 = 4 hours, minimum 5).
# Idle window ke baad refresh par dobara login karna padega.
AUTH_IDLE_MINUTES=240

# Drive-first rollout (OFF by default; server-side only).
BILLING_STORAGE_AUTHORITY=firestore
BILLING_DRIVE_MODULES=
BILLING_DRIVE_TRANSPORT=0
BILLING_DRIVE_FOLDER_ID=
# For isolated staging only: both must match explicit staging credentials/folder.
BILLING_STORAGE_STAGING_PROJECT=
BILLING_STORAGE_STAGING_FOLDER=
# User OAuth for My Drive (never expose these in HTML/JS).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Alternative: service-account JSON or private file path; requires a Shared Drive.
GOOGLE_DRIVE_SERVICE_ACCOUNT=
DAILY_PROGRESS_DRIVE_FOLDER_ID=
# Offline validation only; does not enable flags or contact Google:
# npm run storage:preflight -- --env-file=<private staging env file>
